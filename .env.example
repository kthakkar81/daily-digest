# Copy this to .env and fill in your actual credentials

# Yahoo Email (IMAP)
YAHOO_EMAIL=your_yahoo_email@yahoo.com
YAHOO_PASSWORD=your_app_password_here

# Gmail - OAuth credentials (downloaded from Google Cloud Console)
# Leave blank for now - we'll set this up next

# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email delivery settings
SEND_FROM_EMAIL=your_email@gmail.com
SEND_TO_EMAIL=your_email@gmail.com
DIGEST_SEND_TIME=07:00

# Content settings
DAYS_TO_SCAN=1
MAX_ITEMS_PER_CATEGORY=3

# Email sources to use (comma-separated: gmail, yahoo)
# Examples: "gmail" or "yahoo" or "gmail,yahoo"
EMAIL_SOURCES=gmail
